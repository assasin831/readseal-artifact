# Preserve all evidence and source-snapshot bytes across platforms.
archives/** -text -whitespace
data/** -text -whitespace
provenance/** -text -whitespace
code/** -text -whitespace
evidence-index.json -text
*.md text eol=lf
tools/*.py text eol=lf
.gitattributes text eol=lf
# Match the source ZIP and its per-file manifest exactly, including line endings.
manuscript/** -text -whitespace
manuscript/**/*.pdf -diff
