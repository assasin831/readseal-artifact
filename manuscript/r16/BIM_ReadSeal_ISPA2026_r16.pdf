dup 56 /eight put
dup 61 /equal put
dup 53 /five put
dup 52 /four put
dup 109 /m put
dup 49 /one put
dup 40 /parenleft put
dup 41 /parenright put
dup 43 /plus put
dup 55 /seven put
dup 50 /two put
dup 120 /x put
dup 48 /zero put
readonly def
currentdict end
